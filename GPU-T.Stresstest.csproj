<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifiers>linux-x64</RuntimeIdentifiers>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PublishAot>true</PublishAot>
    <RootNamespace>GPU_T.StressTest</RootNamespace>
    <AssemblyName>GPU-T.StressTest</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
    <StripSymbols>true</StripSymbols>
    <DefaultItemExcludes>$(DefaultItemExcludes);Payloads/**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Payloads/**" />
    <None Remove="Payloads/**" />
  </ItemGroup>

  <!-- NuGet Dependencies -->
  <ItemGroup>
    <PackageReference Include="Silk.NET.Core" Version="2.22.0" />
    <PackageReference Include="Silk.NET.OpenGL" Version="2.22.0" />
    <PackageReference Include="Silk.NET.Vulkan" Version="2.22.0" />
    <PackageReference Include="Silk.NET.Windowing" Version="2.22.0" />
    <PackageReference Include="Silk.NET.Windowing.Glfw" Version="2.22.0" />
    <PackageReference Include="Silk.NET.Input" Version="2.22.0" />
    <PackageReference Include="Silk.NET.Input.Glfw" Version="2.22.0" />
    <PackageReference Include="Silk.NET.Maths" Version="2.22.0" />
  </ItemGroup>

  <!-- Shaders ItemGroup Definition -->
  <ItemGroup>
    <!-- Compute Slang shaders (Exclude Graphics ROP & Depth&Stencil) -->
    <SlangComputeShader Include="Native/Vulkan/Shaders/**/*.slang" 
                        Exclude="Native/Vulkan/Shaders/ROP/**;Native/Vulkan/Shaders/Depth&amp;Stencil/**">
      <Profile>spirv_1_0</Profile>
    </SlangComputeShader>

    <!-- Specific Compute workloads requiring SPIR-V 1.3 / 1.4 -->
    <SlangComputeShader Update="Native/Vulkan/Shaders/MatrixKHR/**/*.slang;Native/Vulkan/Shaders/MatrixNV2/**/*.slang;Native/Vulkan/Shaders/ALU/*bf16*.slang;Native/Vulkan/Shaders/ALU/*dp*.slang">
      <Profile>spirv_1_3</Profile>
    </SlangComputeShader>
    <SlangComputeShader Update="Native/Vulkan/Shaders/RayTracing/**/*.slang">
      <Profile>spirv_1_4</Profile>
    </SlangComputeShader>

    <!-- Graphics Slang shaders (ROP & Depth/Stencil) -->
    <SlangGraphicsShader Include="Native/Vulkan/Shaders/ROP/**/*.slang;Native/Vulkan/Shaders/Depth&amp;Stencil/**/*.slang">
      <Profile>spirv_1_0</Profile>
    </SlangGraphicsShader>

    <!-- Raw SPIR-V Assembly shaders -->
    <SpvasmShader Include="Native/Vulkan/Shaders/**/*.spvasm" />

    <!-- GLSL compute shaders (NVIDIA Matrix 1 & Legacy RT) -->
    <GlslShader Include="Native/Vulkan/Shaders/**/*.comp" />
  </ItemGroup>

  <!-- Automatic Shader Build Pipeline for dotnet build and dotnet publish -->
  <Target Name="CompileVulkanShaders" BeforeTargets="AssignTargetPaths;PrepareResources">
    <PropertyGroup>
      <SpvOutputDir>$(IntermediateOutputPath)spv/</SpvOutputDir>
    </PropertyGroup>

    <MakeDir Directories="$(SpvOutputDir)" />

    <!-- Compile Compute Slang shaders -->
    <Exec Command="slangc &quot;%(SlangComputeShader.Identity)&quot; -target spirv -entry main -stage compute -profile %(SlangComputeShader.Profile) -o &quot;$(SpvOutputDir)%(SlangComputeShader.Filename).spv&quot;"
          Condition="'@(SlangComputeShader)' != ''" />

    <!-- Compile Graphics Slang shaders (Stage detected automatically from [shader(&quot;vertex&quot;)] / [shader(&quot;fragment&quot;)]) -->
    <Exec Command="slangc &quot;%(SlangGraphicsShader.Identity)&quot; -target spirv -entry main -profile %(SlangGraphicsShader.Profile) -o &quot;$(SpvOutputDir)%(SlangGraphicsShader.Filename).spv&quot;"
          Condition="'@(SlangGraphicsShader)' != ''" />

    <!-- Compile GLSL compute shaders -->
    <Exec Command="glslangValidator -V -S comp &quot;%(GlslShader.Identity)&quot; -o &quot;$(SpvOutputDir)%(GlslShader.Filename).spv&quot;"
          Condition="'@(GlslShader)' != ''" />

    <!-- Assemble raw SPIR-V assembly shaders with spirv-as -->
    <Exec Command="spirv-as --target-env spv1.3 &quot;%(SpvasmShader.Identity)&quot; -o &quot;$(SpvOutputDir)%(SpvasmShader.Filename).spv&quot;"
          Condition="'@(SpvasmShader)' != ''" />

    <!-- Gather all compiled .spv files from disk -->
    <ItemGroup>
      <_SpvCompiledFiles Include="$(SpvOutputDir)*.spv" />
    </ItemGroup>

    <!-- Batch over %(_SpvCompiledFiles.Filename) to assign a distinct LogicalName -->
    <ItemGroup>
      <EmbeddedResource Include="@(_SpvCompiledFiles)" LogicalName="Shaders.%(_SpvCompiledFiles.Filename).spv" />
    </ItemGroup>
  </Target>

</Project>