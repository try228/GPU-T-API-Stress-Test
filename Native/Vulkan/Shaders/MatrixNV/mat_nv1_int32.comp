#version 450 core
#extension GL_NV_cooperative_matrix : enable
#extension GL_NV_integer_cooperative_matrix : enable
#extension GL_KHR_shader_subgroup_basic : enable
#extension GL_KHR_memory_scope_semantics : enable
#extension GL_EXT_shader_explicit_arithmetic_types_int32 : enable

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0) buffer BufferA { int a[]; };
layout(set = 0, binding = 1) buffer BufferB { int b[]; };
layout(set = 0, binding = 2) buffer BufferC { int c[]; };

void main()
{
    uint sgIdx = gl_GlobalInvocationID.x / gl_SubgroupSize;
    uint outOffset = (sgIdx * 16u * 16u) & 0x0001FFFFu;

    icoopmatNV<32, gl_ScopeSubgroup, 16, 16> matA;
    icoopmatNV<32, gl_ScopeSubgroup, 16, 16> matB;
    icoopmatNV<32, gl_ScopeSubgroup, 16, 16> acc;

    coopMatLoadNV(matA, a, 0u, 16u, false);
    coopMatLoadNV(matB, b, 0u, 16u, false);
    acc = icoopmatNV<32, gl_ScopeSubgroup, 16, 16>(0);

    for (int i = 0; i < 16; i++)
    {
        acc = coopMatMulAddNV(matA, matB, acc);
    }

    coopMatStoreNV(acc, c, outOffset, 16u, false);
}