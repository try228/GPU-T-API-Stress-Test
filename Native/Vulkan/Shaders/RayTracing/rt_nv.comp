// Native/Vulkan/Shaders/RayTracing/rt_nv.comp
// Legacy NVIDIA Ray Tracing (VK_NV_ray_tracing 2018 Emulation Path) - GLSL Compute

#version 450

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(std430, set = 0, binding = 0) buffer OutputBuffer
{
    uvec4 g_output[];
};

struct Ray
{
    vec3 origin;
    vec3 dir;
    vec3 invDir;
};

// Procedural BVH traversal matching Turing/Pascal NV_ray_tracing emulation
bool IntersectBoxNV(Ray ray, vec3 bMin, vec3 bMax, out float tNear)
{
    vec3 t0 = (bMin - ray.origin) * ray.invDir;
    vec3 t1 = (bMax - ray.origin) * ray.invDir;
    vec3 tmin = min(t0, t1);
    vec3 tmax = max(t0, t1);

    tNear = max(max(tmin.x, tmin.y), tmin.z);
    float tFar = min(min(tmax.x, tmax.y), tmax.z);

    return tFar >= max(tNear, 0.0);
}

bool IntersectTriangleNV(Ray ray, vec3 v0, vec3 v1, vec3 v2, out float t)
{
    vec3 e1 = v1 - v0;
    vec3 e2 = v2 - v0;
    vec3 pvec = cross(ray.dir, e2);
    float det = dot(e1, pvec);

    if (abs(det) < 1e-7) { t = 0.0; return false; }
    float invDet = 1.0 / det;

    vec3 tvec = ray.origin - v0;
    float u = dot(tvec, pvec) * invDet;
    if (u < 0.0 || u > 1.0) { t = 0.0; return false; }

    vec3 qvec = cross(tvec, e1);
    float v = dot(ray.dir, qvec) * invDet;
    if (v < 0.0 || u + v > 1.0) { t = 0.0; return false; }

    t = dot(e2, qvec) * invDet;
    return t > 0.0;
}

void main()
{
    uint tid = gl_GlobalInvocationID.x;
    float seed = float(tid) * 0.015625;

    vec3 bMin = vec3(-1.5, -1.5, 0.5);
    vec3 bMax = vec3( 1.5,  1.5, 3.5);

    vec3 v0 = vec3(-1.0, -1.0, 2.0);
    vec3 v1 = vec3( 1.0, -1.0, 2.0);
    vec3 v2 = vec3( 0.0,  1.0, 2.0);

    uint nvHits = 0;
    float totalT = 0.0;

    for (int r = 0; r < 256; r++)
    {
        float angle = seed + float(r) * 0.024543;
        Ray ray;
        ray.origin = vec3(cos(angle) * 0.5, sin(angle) * 0.5, 0.0);
        ray.dir = normalize(vec3(sin(angle) * 0.2, cos(angle) * 0.2, 1.0));
        ray.invDir = 1.0 / (ray.dir + sign(ray.dir) * 1e-7);

        float tNear;
        if (IntersectBoxNV(ray, bMin, bMax, tNear))
        {
            float tTri;
            if (IntersectTriangleNV(ray, v0, v1, v2, tTri))
            {
                nvHits++;
                totalT += tTri;
            }
        }
    }

    g_output[tid] = uvec4(nvHits, floatBitsToUint(totalT), tid, 0x4E565254); // 'NVRT'
}